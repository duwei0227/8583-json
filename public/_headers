# Cloudflare 静态资源响应头（构建时随 public/ 复制到 dist/）
# CSP：只允许本站资源，报文不会被发往任何其他地址；wasm-unsafe-eval 用于加载编解码 WASM
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# 带内容哈希的构建产物可以长期缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable
