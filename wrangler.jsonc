{
  // Cloudflare Workers 静态站点：只托管 dist/，没有 Worker 脚本
  // 由 GitHub Actions（.github/workflows/deploy-web.yml）构建后执行 wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iso8583-json",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // 自定义域名：部署时自动创建 DNS 记录和证书，要求 probiecoder.cn 已托管在同一 Cloudflare 账号
  "routes": [{ "pattern": "8583.probiecoder.cn", "custom_domain": true }]
}
